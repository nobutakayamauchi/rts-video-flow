{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rts.local/schemas/debug-assessment.schema.json",
  "title": "RTS Debug Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assessment_id", "incident_id", "status", "failure_class", "first_divergence", "observations", "inferences", "confidence", "missing_evidence", "release_blocking", "reproduction_steps", "required_tests"],
  "properties": {
    "version": {"const": 1},
    "assessment_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "incident_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "status": {"const": "DIAGNOSED"},
    "failure_class": {"type": "string", "minLength": 1, "maxLength": 128},
    "first_divergence": {"type": ["object", "null"]},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "missing_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "release_blocking": {"type": "boolean"},
    "reproduction_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "suspected_paths": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "uniqueItems": true},
    "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
