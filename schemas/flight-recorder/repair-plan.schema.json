{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rts.local/schemas/repair-plan.schema.json",
  "title": "RTS Repair Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plan_id", "incident_id", "assessment_id", "status", "repository", "base_ref", "repair_branch", "reproduction_test", "allowed_paths", "forbidden_paths", "limits", "human_approval_required"],
  "properties": {
    "version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "incident_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "assessment_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "status": {"const": "REPRODUCTION_READY"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "repair_branch": {"type": "string", "pattern": "^repair/[A-Za-z0-9._/-]+$"},
    "reproduction_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "command", "failed_before_patch"],
      "properties": {
        "path": {"type": "string", "pattern": "^tests/(?!.*\\.\\.).+"},
        "command": {"type": "string", "minLength": 1},
        "failed_before_patch": {"const": true}
      }
    },
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_changed_files", "max_changed_lines", "max_new_dependencies"],
      "properties": {
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_new_dependencies": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "human_approval_required": {"const": true}
  }
}
